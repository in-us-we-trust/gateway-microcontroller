{
    "swagger": "2.0",
    "info": {
        "description": "IoT gateway for the Secure Home project — routes microcontroller events to the detection service.",
        "title": "Secure Home Gateway API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/events": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Receives a security event from an IoT microcontroller and propagates it to the detection service",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "events"
                ],
                "summary": "Report a security event",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Should send certs and extracted from GCP load balancer (only if mtls enabled)",
                        "name": "X-Client-Cert-Subject",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Device identifier (only if mtls disabled)",
                        "name": "X-Device-ID",
                        "in": "header"
                    },
                    {
                        "description": "Event payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.EventRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.EventResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    }
                }
            }
        },
        "/devices": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Registers a new IoT device with the devices controller",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Register a new device",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Should send certs and extracted from GCP load balancer (only if mtls enabled)",
                        "name": "X-Client-Cert-Subject",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Device identifier (only if mtls disabled)",
                        "name": "X-Device-ID",
                        "in": "header"
                    },
                    {
                        "description": "Device registration payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.DeviceRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.DeviceResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "apierror.APIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "DTE-001"
                },
                "detail": {
                    "type": "string",
                    "example": "The image field is required"
                },
                "instance": {
                    "type": "string",
                    "example": "/api/v1/events"
                },
                "status": {
                    "type": "integer",
                    "example": 400
                },
                "title": {
                    "type": "string",
                    "example": "Bad Request"
                },
                "type": {
                    "type": "string",
                    "example": "about:blank"
                }
            }
        },
        "domain.DeviceData": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "example": "San Miguel"
                },
                "detectionThreshold": {
                    "type": "number",
                    "example": 85
                },
                "firmwareVersion": {
                    "type": "string",
                    "example": "v1.3.7"
                },
                "id": {
                    "type": "string",
                    "example": "9df4a749-3ec2-43b9-bc42-35d2b6b5b173"
                },
                "lastBoot": {
                    "type": "string",
                    "example": "2026-06-27T17:45:00Z"
                },
                "lastSeen": {
                    "type": "string",
                    "example": "2026-06-27T18:30:00Z"
                },
                "location": {
                    "type": "string",
                    "example": "Main Entrance"
                },
                "serialNumber": {
                    "type": "string",
                    "example": "ESP32-000001"
                },
                "status": {
                    "type": "string",
                    "example": "UNCLAIMED"
                },
                "uptime": {
                    "type": "integer",
                    "example": 2700
                }
            }
        },
        "domain.DeviceRequest": {
            "type": "object",
            "required": [
                "lastBoot",
                "lastSeen",
                "serialNumber"
            ],
            "properties": {
                "city": {
                    "type": "string",
                    "example": "San Miguel"
                },
                "detectionThreshold": {
                    "type": "number",
                    "example": 85
                },
                "firmwareVersion": {
                    "type": "string",
                    "example": "v1.3.7"
                },
                "lastBoot": {
                    "type": "string",
                    "example": "2026-06-27T17:45:00Z"
                },
                "lastSeen": {
                    "type": "string",
                    "example": "2026-06-27T18:30:00Z"
                },
                "location": {
                    "type": "string",
                    "example": "Front door"
                },
                "serialNumber": {
                    "type": "string",
                    "example": "ESP32-000001"
                }
            }
        },
        "domain.DeviceResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/domain.DeviceData"
                }
            }
        },
        "domain.EventData": {
            "type": "object",
            "properties": {
                "deviceId": {
                    "type": "string",
                    "example": "9df4a749-3ec2-43b9-bc42-35d2b6b5b173"
                },
                "eventId": {
                    "type": "string",
                    "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
                },
                "eventType": {
                    "type": "string",
                    "example": "motion"
                },
                "faceRecognition": {
                    "$ref": "#/definitions/domain.FaceRecognition"
                },
                "imageUrl": {
                    "type": "string",
                    "example": "https://storage.example.com/events/3fa85f64-5717-4562-b3fc-2c963f66afa6.jpg"
                },
                "isIntruder": {
                    "type": "boolean",
                    "example": true
                },
                "timestamp": {
                    "type": "string",
                    "example": "2026-06-28T21:19:59.466Z"
                }
            }
        },
        "domain.EventRequest": {
            "type": "object",
            "required": [
                "image",
                "type"
            ],
            "properties": {
                "image": {
                    "type": "string",
                    "example": "/9j/4AAQSkZJRgABAQAAAQABAAD..."
                },
                "type": {
                    "enum": [
                        "bell",
                        "motion"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.EventType"
                        }
                    ],
                    "example": "motion"
                }
            }
        },
        "domain.EventResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/domain.EventData"
                }
            }
        },
        "domain.EventType": {
            "type": "string",
            "enum": [
                "bell",
                "motion"
            ],
            "x-enum-varnames": [
                "EventTypeBell",
                "EventTypeMotion"
            ]
        },
        "domain.FaceRecognition": {
            "type": "object",
            "properties": {
                "closest_match": {
                    "type": "string",
                    "example": "John Doe"
                },
                "detector_backend": {
                    "type": "string",
                    "example": "retinaface"
                },
                "distance": {
                    "type": "number",
                    "example": 0.82
                },
                "distance_metric": {
                    "type": "string",
                    "example": "cosine"
                },
                "known": {
                    "type": "boolean",
                    "example": false
                },
                "model_name": {
                    "type": "string",
                    "example": "Facenet512"
                },
                "threshold": {
                    "type": "number",
                    "example": 0.6
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}