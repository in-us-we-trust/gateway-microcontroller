{
    "swagger": "2.0",
    "info": {
        "description": "IoT gateway for the Secure Home project — routes microcontroller events to the detection service.",
        "title": "Secure Home Gateway API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/events": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Receives a security event from an IoT microcontroller and propagates it to the detection service",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "events"
                ],
                "summary": "Report a security event",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Should send certs and extracted from GCP load balancer (only if mtls enabled)",
                        "name": "X-Client-Cert-Subject",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Device identifier (only if mtls disabled)",
                        "name": "X-Device-ID",
                        "in": "header"
                    },
                    {
                        "description": "Event payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.EventRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.EventResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/apierror.APIError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "apierror.APIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "DTE-001"
                },
                "detail": {
                    "type": "string",
                    "example": "The image field is required"
                },
                "instance": {
                    "type": "string",
                    "example": "/api/v1/events"
                },
                "status": {
                    "type": "integer",
                    "example": 400
                },
                "title": {
                    "type": "string",
                    "example": "Bad Request"
                },
                "type": {
                    "type": "string",
                    "example": "about:blank"
                }
            }
        },
        "domain.EventData": {
            "type": "object",
            "properties": {
                "deviceId": {
                    "type": "string"
                },
                "eventId": {
                    "type": "string"
                },
                "eventType": {
                    "type": "string"
                },
                "faceRecognition": {
                    "$ref": "#/definitions/domain.FaceRecognition"
                },
                "imageUrl": {
                    "type": "string"
                },
                "isIntruder": {
                    "type": "boolean"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "domain.EventRequest": {
            "type": "object",
            "required": [
                "image",
                "type"
            ],
            "properties": {
                "image": {
                    "type": "string"
                },
                "type": {
                    "enum": [
                        "bell",
                        "motion"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.EventType"
                        }
                    ]
                }
            }
        },
        "domain.EventResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/domain.EventData"
                }
            }
        },
        "domain.EventType": {
            "type": "string",
            "enum": [
                "bell",
                "motion"
            ],
            "x-enum-varnames": [
                "EventTypeBell",
                "EventTypeMotion"
            ]
        },
        "domain.FaceRecognition": {
            "type": "object",
            "properties": {
                "closest_match": {
                    "type": "string"
                },
                "detector_backend": {
                    "type": "string"
                },
                "distance": {
                    "type": "number"
                },
                "distance_metric": {
                    "type": "string"
                },
                "known": {
                    "type": "boolean"
                },
                "model_name": {
                    "type": "string"
                },
                "threshold": {
                    "type": "number"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}