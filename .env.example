PORT=8080
DETECTIVE_MANAGER_URL=https://your-detective-manager.example
ENABLE_MTLS=false
MQTT_ENABLED=true
MQTT_CLIENT_ID=gateway-micro
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BROKER_URL=ssl://api.hogarseguro.local:8883
MQTT_CA_CERT=/certs/ca.crt
MQTT_CLIENT_CERT=/certs/gateway.crt
MQTT_CLIENT_KEY=/certs/gateway.key
MQTT_TLS_INSECURE=false
SESSION_TTL=30s
AUDIO_CHUNK_DURATION=10s
VIDEO_CHUNK_DURATION=5s
AUDIO_FORMAT=mp3
FFMPEG_PATH=ffmpeg
RTSP_BASE=rtsps://gateway-micro:fiuba-rtsp-reader@api.hogarseguro.local:8322
RTSP_CA_CERT=/certs/ca.crt
RTSP_TLS_INSECURE=false
MEDIA_REQUEST_TIMEOUT=15s
MEDIA_CHUNK_BATCH_SIZE=1
PRESS_MAX_INFLIGHT=8
# Config para debug de chunks de media
# DEBUG_MEDIA_ENABLED=true
# DEBUG_MEDIA_MAX_FILES=20
# DEBUG_MEDIA_DIR=/app/debug-chunks
