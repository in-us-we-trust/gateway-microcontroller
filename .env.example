PORT=8080
DETECTIVE_MANAGER_URL=https://your-detective-manager.example
ENABLE_MTLS=false
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=gateway-micro
MQTT_USERNAME=
MQTT_PASSWORD=
SESSION_TTL=30s
AUDIO_CHUNK_DURATION=10s
VIDEO_CHUNK_DURATION=5s
AUDIO_FORMAT=mp3
FFMPEG_PATH=ffmpeg
MEDIA_REQUEST_TIMEOUT=15s
MEDIA_CHUNK_BATCH_SIZE=1
# Config para debug de chunks de media
# DEBUG_MEDIA_ENABLED=true
# DEBUG_MEDIA_MAX_FILES=20
# DEBUG_MEDIA_DIR=/app/debug-chunks
